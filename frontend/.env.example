# Public origin only. No database or Supabase service credentials belong here.
# Recommended browser API uses same-origin /api/v1 via the Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Server-only Go backend URL, e.g. http://localhost:8080 locally, HTTPS in production.
BACKEND_URL=
# Enable the live product editor after API acceptance tests. Production checks Go sessions.
NEXT_PUBLIC_ENABLE_LIVE_CATALOG=false
